# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is listed in .gitignore.

# JWT Secret — generate a strong random string (e.g. openssl rand -hex 32)
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING

# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_password_here

# Database (leave blank to use local SQLite, or paste Railway Postgres URL)
DATABASE_URL=sqlite+aiosqlite:///./local.db

# Cloudinary — for persistent image storage (optional but recommended on Railway)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
